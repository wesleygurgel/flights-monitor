# Banco (compose já aponta para o postgres; para teste local sem Docker use sqlite)
DATABASE_URL=postgresql+psycopg2://monitor:monitor@db:5432/monitor
# DATABASE_URL=sqlite:///./monitor.db

# Painel web (http://localhost:8000)
APP_PASSWORD=troque-esta-senha
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# E-mail (SMTP). Para Gmail use senha de app.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@gmail.com
SMTP_PASS=senha-de-app
EMAIL_TO=seu@gmail.com

# WhatsApp via Evolution API (self-hosted)
EVOLUTION_URL=http://evolution:8080
EVOLUTION_APIKEY=troque-aqui
EVOLUTION_INSTANCE=monitor
WHATSAPP_TO=5584999999999

# Agenda (cron, hora local)
TZ=America/Sao_Paulo
COARSE_CRON=0 6 * * *
FINE_CRON=0 8,14,20 * * *

# Pausa entre chamadas ao Google (segundos) para evitar 429
REQUEST_DELAY=4
